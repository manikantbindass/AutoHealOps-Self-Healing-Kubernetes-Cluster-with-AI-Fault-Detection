# Explicit, safe local development defaults. Production requires strong credentials.
MODE=demo
ENVIRONMENT=development
DRY_RUN=true
ALLOW_AUTOMATIC=false
HEALING_MODE=manual
NAMESPACE=autohealops
MAX_REPLICAS=5
COOLDOWN_SECONDS=300
POLL_SECONDS=5
RETENTION_DAYS=7
ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=
ADMIN_PASSWORD=
VIEWER_PASSWORD=
# scripts/setup.ps1 generates Grafana's random password without printing it.
GRAFANA_ADMIN_PASSWORD=
# Native demo uses SQLite when MONGO_URI is empty; Compose supplies internal Mongo DNS.
MONGO_URI=
AI_URL=http://127.0.0.1:8001
PROMETHEUS_URL=http://127.0.0.1:9090
# Optional notifications; secrets are never returned through the settings API.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
